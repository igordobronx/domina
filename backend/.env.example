## copie este arquivo para .env e troque os valores

## banco: sqlite pra teste rapido local, postgres no docker/producao
## (no docker-compose esta variavel ja vem pronta, nao precisa mexer)
DATABASE_URL=sqlite:///./domina.db
# DATABASE_URL=postgresql://domina:domina@localhost:5432/domina

## chave do JWT: gere uma com  python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=troque_esta_chave
JWT_EXPIRE_MINUTES=120

## OCR do manuscrito pelo Gemini. Chave em https://aistudio.google.com/apikey
## Sem ela a API sobe, mas o OCR responde 503.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
