## copie este arquivo para .env e troque os valores

## banco: postgres e o padrao agora (sobe com "docker compose up -d db").
## sqlite fica so de fallback pra teste isolado/offline, sem docker
## PORTA 5433 (nao 5432): se sua maquina ja tem um Postgres proprio na 5432,
## use outra porta aqui tambem (ou vai conectar no Postgres errado sem perceber)
DATABASE_URL=postgresql://domina:domina@localhost:5433/domina
# DATABASE_URL=sqlite:///./domina.db

## chave do JWT: gere uma com  python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=troque_esta_chave
JWT_EXPIRE_MINUTES=120

## OCR do manuscrito pelo Gemini. Chave em https://aistudio.google.com/apikey
## Sem ela a API sobe, mas o OCR responde 503.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
