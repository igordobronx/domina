# Imagem unica para a hospedagem de TESTE (Render): constroi o site (React) e serve junto com a API.
# Contexto = raiz do repositorio. Nao usada em producao nem no dev.sh.
FROM node:22-slim AS site
WORKDIR /site
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
# VITE_API_URL vazio = o site chama a API na mesma URL (sem CORS)
ENV VITE_API_URL=""
RUN npm run build

FROM python:3.12-slim
WORKDIR /app
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY backend/ .
COPY --from=site /site/dist /app/site_dist
EXPOSE 8000
CMD ["sh", "-c", "python migrar.py && python seed.py && uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
